digraph G {
  rankdir = "RL";
  node [shape = rect, fontname = "sans-serif"];
  subgraph "cluster_module.compute" {
    label = "module.compute"
    fontname = "sans-serif"
    "module.compute.data.aws_ami.ubuntu" [label="data.aws_ami.ubuntu"];
    "module.compute.aws_instance.db" [label="aws_instance.db"];
    "module.compute.aws_instance.web" [label="aws_instance.web"];
  }
  subgraph "cluster_module.network" {
    label = "module.network"
    fontname = "sans-serif"
    "module.network.aws_internet_gateway.igw" [label="aws_internet_gateway.igw"];
    "module.network.aws_route_table.public" [label="aws_route_table.public"];
    "module.network.aws_route_table_association.public" [label="aws_route_table_association.public"];
    "module.network.aws_security_group.db" [label="aws_security_group.db"];
    "module.network.aws_security_group.web" [label="aws_security_group.web"];
    "module.network.aws_subnet.private" [label="aws_subnet.private"];
    "module.network.aws_subnet.public" [label="aws_subnet.public"];
    "module.network.aws_vpc.main" [label="aws_vpc.main"];
  }
  "module.compute.aws_instance.db" -> "module.compute.data.aws_ami.ubuntu";
  "module.compute.aws_instance.db" -> "module.network.aws_security_group.db";
  "module.compute.aws_instance.db" -> "module.network.aws_subnet.private";
  "module.compute.aws_instance.web" -> "module.compute.data.aws_ami.ubuntu";
  "module.compute.aws_instance.web" -> "module.network.aws_security_group.web";
  "module.compute.aws_instance.web" -> "module.network.aws_subnet.public";
  "module.network.aws_internet_gateway.igw" -> "module.network.aws_vpc.main";
  "module.network.aws_route_table.public" -> "module.network.aws_internet_gateway.igw";
  "module.network.aws_route_table_association.public" -> "module.network.aws_route_table.public";
  "module.network.aws_route_table_association.public" -> "module.network.aws_subnet.public";
  "module.network.aws_security_group.db" -> "module.network.aws_security_group.web";
  "module.network.aws_security_group.web" -> "module.network.aws_vpc.main";
  "module.network.aws_subnet.private" -> "module.network.aws_vpc.main";
  "module.network.aws_subnet.public" -> "module.network.aws_vpc.main";
}
